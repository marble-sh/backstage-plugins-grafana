{
  "name": "@marble-sh/backstage-plugin-grafana",
  "version": "1.3.2",
  "description": "Frontend for the Grafana Backstage plugin: entity dashboard/alert content and a standalone instances page",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "backstage": {
    "role": "frontend-plugin",
    "pluginId": "grafana",
    "pluginPackages": [
      "@marble-sh/backstage-plugin-grafana",
      "@marble-sh/backstage-plugin-grafana-backend",
      "@marble-sh/backstage-plugin-grafana-common",
      "@marble-sh/backstage-plugin-grafana-node"
    ]
  },
  "sideEffects": false,
  "scripts": {
    "start": "backstage-cli package start",
    "build": "backstage-cli package build",
    "clean": "backstage-cli package clean",
    "lint": "backstage-cli package lint",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack",
    "test": "backstage-cli package test"
  },
  "dependencies": {
    "@backstage/catalog-model": "backstage:^",
    "@backstage/core-compat-api": "backstage:^",
    "@backstage/core-components": "backstage:^",
    "@backstage/core-plugin-api": "backstage:^",
    "@backstage/errors": "backstage:^",
    "@backstage/frontend-plugin-api": "backstage:^",
    "@backstage/plugin-catalog-react": "backstage:^",
    "@backstage/theme": "backstage:^",
    "@marble-sh/backstage-plugin-grafana-common": "workspace:^",
    "@material-ui/core": "^4.12.2",
    "@material-ui/icons": "^4.11.3",
    "react-use": "^17.2.4",
    "recharts": "^3.10.1"
  },
  "peerDependencies": {
    "@types/react": "^17.0.0 || ^18.0.0",
    "react": "^17.0.0 || ^18.0.0",
    "react-dom": "^17.0.0 || ^18.0.0",
    "react-router-dom": "^6.30.2"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@backstage/cli": "backstage:^",
    "@backstage/core-app-api": "backstage:^",
    "@backstage/frontend-defaults": "backstage:^",
    "@backstage/frontend-dev-utils": "backstage:^",
    "@backstage/frontend-test-utils": "backstage:^",
    "@backstage/test-utils": "backstage:^",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^15.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/lodash": "^4.14.151",
    "@types/react": "^18.0.0",
    "react": "^18.0.2",
    "react-dom": "^18.0.2",
    "react-router-dom": "^6.30.2"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/marble-sh/backstage-plugins-grafana",
    "directory": "plugins/grafana"
  },
  "keywords": [
    "backstage",
    "plugin",
    "grafana"
  ],
  "author": "Cassidy Marble",
  "homepage": "https://github.com/marble-sh/backstage-plugins-grafana/tree/main/plugins/grafana",
  "bugs": "https://github.com/marble-sh/backstage-plugins-grafana/issues",
  "exports": {
    ".": "./src/index.ts",
    "./alpha": "./src/alpha.tsx",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "alpha": [
        "src/alpha.tsx"
      ],
      "package.json": [
        "package.json"
      ]
    }
  }
}
