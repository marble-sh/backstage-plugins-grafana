{
  "uid": "backstage-observability",
  "title": "Backstage Observability",
  "tags": ["backstage"],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": true,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "5m",
  "templating": {
    "list": [
      {
        "name": "prometheus",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus"
      },
      {
        "name": "loki",
        "label": "Loki (optional)",
        "type": "datasource",
        "query": "loki"
      },
      {
        "name": "namespace",
        "label": "Log namespace",
        "type": "textbox",
        "query": "backstage"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "About",
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "Example dashboard for monitoring a Backstage instance \u2014 see `docs/observability.md` in `marble-sh/backstage-plugins-grafana` for how to emit these metrics (OpenTelemetry + Prometheus exporter) and logs (Loki). Panels marked *(logs)* need the Loki datasource and the documented sign-in log line."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Entities total",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 0,
        "y": 3
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(max by (kind) (catalog_entities_count))",
          "legendFormat": "entities"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Entities by kind",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "h": 7,
        "w": 18,
        "x": 6,
        "y": 3
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10
          },
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (kind) (catalog_entities_count)",
          "legendFormat": "{{kind}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Request rate by plugin",
      "description": "Per-plugin breakdown via the /api/<plugin-id> route prefix.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (plugin) (label_replace(rate(http_server_request_duration_count[5m]), \"plugin\", \"$1\", \"http_route\", \"/api/([^/]+).*\"))",
          "legendFormat": "{{plugin}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "5xx error ratio by plugin",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10
          },
          "unit": "percentunit",
          "max": 1,
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum by (plugin) (label_replace(rate(http_server_request_duration_count{http_response_status_code=~\"5..\"}[5m]), \"plugin\", \"$1\", \"http_route\", \"/api/([^/]+).*\")) or sum by (plugin) (label_replace(rate(http_server_request_duration_count[5m]), \"plugin\", \"$1\", \"http_route\", \"/api/([^/]+).*\")) * 0) / sum by (plugin) (label_replace(rate(http_server_request_duration_count[5m]), \"plugin\", \"$1\", \"http_route\", \"/api/([^/]+).*\"))",
          "legendFormat": "{{plugin}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "p95 latency by route",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10
          },
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, http_route) (rate(http_server_request_duration_bucket[5m])))",
          "legendFormat": "{{http_route}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Template runs by result (24h)",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (increase(scaffolder_task_count_total[24h]))",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Scaffolder task p95 duration",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "h": 7,
        "w": 16,
        "x": 8,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10
          },
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(scaffolder_task_duration_bucket[30m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Errors by plugin (logs)",
      "description": "Every Backstage backend log line carries a `plugin` field.",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 25
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10
          },
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (plugin) (count_over_time({namespace=\"$namespace\"} | json | level=`error` [5m]))",
          "legendFormat": "{{plugin}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Unique users signed in (24h) (logs)",
      "description": "Needs the sign-in resolver log line from docs/observability.md.",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 25
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(sum by (userEntityRef) (count_over_time({namespace=\"$namespace\"} | json | message=`user signed in` [24h])))",
          "legendFormat": "users"
        }
      ]
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Auth session refreshes (24h)",
      "description": "Coarse proxy for active sessions when logs are unavailable.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 25
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(http_server_request_duration_count{http_route=~\"/api/auth/.*\"}[24h]))",
          "legendFormat": "refreshes"
        }
      ]
    }
  ]
}
